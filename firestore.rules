rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Administradores: usuarios de Firebase Auth con estos emails.
    // En el panel se ingresa solo "user"; internamente es user@tienda-admin.local.
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.email in ['user@tienda-admin.local']
            || exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }

    // Un pedido nuevo solo puede crearse con esta forma y tamaños (evita basura y abuso).
    function validOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['customer', 'items', 'itemCount', 'shipping', 'discount', 'coupon', 'total', 'code', 'status', 'createdAt'])
        && d.keys().hasAll(['customer', 'items', 'total', 'code', 'status', 'createdAt'])
        && d.status == 'nuevo'
        && d.createdAt == request.time
        && d.customer is map
        && d.customer.keys().hasOnly(['name', 'phone', 'delivery', 'address', 'zone', 'pickup', 'payment', 'note', 'email'])
        && d.customer.name is string && d.customer.name.size() > 0 && d.customer.name.size() <= 80
        && d.customer.phone is string && d.customer.phone.size() >= 7 && d.customer.phone.size() <= 30
        && d.customer.delivery in ['retiro', 'envio']
        && (!('address' in d.customer) || (d.customer.address is string && d.customer.address.size() <= 200))
        && (!('pickup' in d.customer) || (d.customer.pickup is string && d.customer.pickup.size() <= 80))
        && (!('zone' in d.customer) || (d.customer.zone is string && d.customer.zone.size() <= 80))
        && (!('discount' in d) || (d.discount is number && d.discount >= 0 && d.discount <= 10000000))
        && (!('coupon' in d) || (d.coupon is string && d.coupon.size() <= 30))
        && (!('shipping' in d) || (d.shipping is number && d.shipping >= 0 && d.shipping <= 100000))
        && (!('itemCount' in d) || (d.itemCount is number && d.itemCount <= 200))
        && (!('payment' in d.customer) || (d.customer.payment is string && d.customer.payment.size() <= 60))
        && (!('note' in d.customer) || (d.customer.note is string && d.customer.note.size() <= 500))
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.total is number && d.total >= 0
        && d.code is string && d.code.size() <= 20;
    }

    // Catálogo, banners y ajustes: lectura pública, escritura solo admins.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Administradores adicionales (se gestionan desde el panel > Usuarios).
    match /admins/{email} {
      allow read, write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Estado público de un pedido (sin datos personales): el cliente lo consulta con su código.
    match /orderStatus/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['status', 'updatedAt', 'createdAt', 'pids', 'items', 'total', 'shipping', 'discount', 'delivery', 'zone', 'payment', 'history'])
        && request.resource.data.status == 'nuevo'
        && code.size() <= 20
        && request.resource.data.pids is list && request.resource.data.pids.size() <= 50
        && request.resource.data.items is list && request.resource.data.items.size() <= 50
        && request.resource.data.history is list && request.resource.data.history.size() <= 1;
      allow update, delete: if isAdmin();
    }

    // Reseñas: cualquiera puede enviar una (queda "pending"); solo se leen las aprobadas; el admin modera.
    match /reviews/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      // Opinión abierta (solo si la tienda no exige compra verificada)
      allow create: if reviewBase()
        && request.resource.data.keys().hasOnly(['productId', 'name', 'rating', 'text', 'status', 'createdAt'])
        && !(exists(/databases/$(database)/documents/settings/store) && get(/databases/$(database)/documents/settings/store).data.get('reviewsMode', 'on') == 'verified');
      // Opinión de comprador: el pedido existe, el admin lo marcó "Entregado" y contiene el producto. Un solo id por pedido+producto.
      allow create: if reviewBase()
        && request.resource.data.keys().hasOnly(['productId', 'name', 'rating', 'text', 'status', 'createdAt', 'orderCode', 'verified'])
        && request.resource.data.verified == true
        && request.resource.data.orderCode is string
        && id == request.resource.data.orderCode + '_' + request.resource.data.productId
        && exists(/databases/$(database)/documents/orderStatus/$(request.resource.data.orderCode))
        && get(/databases/$(database)/documents/orderStatus/$(request.resource.data.orderCode)).data.status == 'entregado'
        && request.resource.data.productId in get(/databases/$(database)/documents/orderStatus/$(request.resource.data.orderCode)).data.pids;
      allow update, delete: if isAdmin();
    }
    function reviewBase() {
      let d = request.resource.data;
      return d.status == 'pending'
        && d.createdAt == request.time
        && d.productId is string && d.productId.size() > 0 && d.productId.size() <= 100
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.text is string && d.text.size() <= 600;
    }

    // Lista de espera de stock: cualquiera se anota; solo el admin lee y borra.
    match /waitlist/{id} {
      allow create: if request.resource.data.keys().hasOnly(['productId', 'contact', 'createdAt'])
        && request.resource.data.productId is string && request.resource.data.productId.size() <= 100
        && request.resource.data.contact is string && request.resource.data.contact.size() >= 6 && request.resource.data.contact.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Pedidos: cualquiera puede crear uno (con validación); solo admins los ven y cambian.
    match /orders/{id} {
      allow create: if validOrder();
      allow read, update, delete: if isAdmin();
    }
  }
}
